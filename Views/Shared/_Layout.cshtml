<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - The App</title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        .app-brand {
            letter-spacing: 0.15em;
            font-weight: 800;
            color: #2563eb;
        }
        .table > :not(caption) > * > * {
            padding: 0.75rem 1rem;
        }
        .btn-toolbar-item {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.35rem;
        }
        /* Mobile & Responsive Sign-in Styles */
        .form-signin {
            width: 100%;
            max-width: 380px;
            padding: 1.5rem 1rem;
            margin: auto;
        }
        .form-signin .form-control {
            font-size: 1rem; /* Prevents auto-zoom on iOS */
        }
        .form-signin .form-floating:focus-within {
            z-index: 2;
        }
        .form-signin input[type="email"]#floatingInput {
            margin-bottom: -1px;
            border-bottom-right-radius: 0;
            border-bottom-left-radius: 0;
        }
        .form-signin input[type="password"]#floatingPassword {
            margin-bottom: 12px;
            border-top-left-radius: 0;
            border-top-right-radius: 0;
        }
        .form-signin .input-name {
            margin-bottom: -1px;
            border-bottom-right-radius: 0;
            border-bottom-left-radius: 0;
        }
        .form-signin .input-email {
            margin-bottom: -1px;
            border-radius: 0;
        }
        .form-signin .input-password {
            margin-bottom: 12px;
            border-top-left-radius: 0;
            border-top-right-radius: 0;
        }
        .form-signin .btn-submit {
            min-height: 46px;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 8px;
        }
    </style>
</head>
<body class="bg-light">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="navbar navbar-expand-lg navbar-white bg-white border-bottom shadow-sm py-2">
            <div class="container">
                <a class="navbar-brand app-brand fs-5" asp-controller="Users" asp-action="Index">
                    THE APP
                </a>
                <div class="d-flex align-items-center gap-3 ms-auto">
                    <span class="text-muted small">
                        Hello, <strong class="text-dark">@User.Identity.Name</strong>
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-outline-danger btn-sm px-3">
                            <i class="bi bi-box-arrow-right me-1"></i> Logout
                        </button>
                    </form>
                </div>
            </div>
        </nav>
    }

    <main role="main">
        @RenderBody()
    </main>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        // Global SweetAlert Toast helper
        window.showToast = function(message, icon = 'success') {
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3500,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
            Toast.fire({ icon: icon, title: message });
        };

        // Server-side TempData message handlers
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            document.addEventListener("DOMContentLoaded", () => {
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["SuccessMessage"]?.ToString() ?? ""))',
                    confirmButtonColor: '#0d6efd'
                });
            });
            </text>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            document.addEventListener("DOMContentLoaded", () => {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["ErrorMessage"]?.ToString() ?? ""))',
                    confirmButtonColor: '#dc3545'
                });
            });
            </text>
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>