@model UserManagementApp.ViewModels.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sign In";
    var blocked = Context.Request.Query["blocked"].ToString();
}

<div class="d-flex flex-column align-items-center justify-content-center min-vh-100 px-3 py-4 bg-body-tertiary">
    <div class="form-signin text-center">
        <form asp-action="Login" method="post" novalidate>
            @Html.AntiForgeryToken()

            <!-- Welcome Header -->
            <div class="mb-4">
                <h1 class="h4 fw-bold text-dark mb-2">Welcome to User Management App</h1>
                <p class="text-secondary mb-0">Please sign in</p>
            </div>

            <!-- SweetAlert2 Notifications -->
            @if (!ViewData.ModelState.IsValid)
            {
                var errors = ViewData.ModelState.Values
                    .SelectMany(v => v.Errors)
                    .Select(e => e.ErrorMessage)
                    .Where(e => !string.IsNullOrEmpty(e))
                    .ToList();
                var errorHtml = string.Join("<br>", errors);
                <script>
                    document.addEventListener("DOMContentLoaded", () => {
                        Swal.fire({
                            icon: 'error',
                            title: 'Sign In Failed',
                            html: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(errorHtml))',
                            confirmButtonColor: '#0d6efd'
                        });
                    });
                </script>
            }
            else if (blocked == "true")
            {
                <script>
                    document.addEventListener("DOMContentLoaded", () => {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Session Ended',
                            text: 'Your session has ended because your account is blocked or deleted.',
                            confirmButtonColor: '#0d6efd'
                        });
                    });
                </script>
            }

            <div class="form-floating">
                <input asp-for="Email" type="email" class="form-control @(!ViewData.ModelState.IsValid && ViewData.ModelState["Email"]?.Errors.Count > 0 ? "is-invalid" : "")" id="floatingInput" placeholder="name@example.com" autofocus autocomplete="email" required>
                <label for="floatingInput">Email address</label>
            </div>
            <div class="form-floating">
                <input asp-for="Password" type="password" class="form-control @(!ViewData.ModelState.IsValid && ViewData.ModelState["Password"]?.Errors.Count > 0 ? "is-invalid" : "")" id="floatingPassword" placeholder="Password" autocomplete="current-password" required>
                <label for="floatingPassword">Password</label>
            </div>

            <div class="form-check text-start my-3">
                <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="flexCheckDefault">
                <label class="form-check-label user-select-none" for="flexCheckDefault">
                    Remember me
                </label>
            </div>

            <button class="btn btn-primary btn-submit w-100 py-2" type="submit">Sign in</button>

            <div class="mt-4 small text-center">
                <span class="text-secondary">Don't have an account?</span>
                <a asp-controller="Account" asp-action="Register" class="text-decoration-none fw-semibold ms-1">Sign up</a>
            </div>
        </form>
    </div>
</div>